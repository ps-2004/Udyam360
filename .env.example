# Udyam360 Full-Stack Environment Variables
PORT=8000

# Database Configuration (SQLite local, PostgreSQL on Render)
DATABASE_URL="sqlite:///./udyam360.db"
# Example PostgreSQL for Render:
# DATABASE_URL="postgresql://user:password@dpg-xxxxxx.singapore-postgres.render.com/udyam360_db"

# API Base URL for Frontend (leave blank for same-origin dev/monolith)
VITE_API_BASE_URL=""
# In split Render deployment:
# NEXT_PUBLIC_API_BASE_URL="https://udyam360-backend.onrender.com"

# CORS configuration for FastAPI backend
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://udyam360-frontend.onrender.com"

# Document Storage Path (Render Persistent Disk recommended in production)
UPLOAD_DIR="./uploads"
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=liquid/lfm-3-1.7b:free